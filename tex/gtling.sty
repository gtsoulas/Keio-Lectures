\def\gtl@tmp{linguex}\ifx\gtl@examples\gtl@tmp
  \RequirePackage{linguex}
  \renewcommand{\firstrefdash}{}          % (1a), not (1-a)
  \AtBeginDocument{%
    \setlength{\Extopsep}{0.6em}%
    \setlength{\Exlabelsep}{0.8em}%
    \setlength{\SubExleftmargin}{1.6em}}
\fi
\def\gtl@tmp{expex}\ifx\gtl@examples\gtl@tmp \RequirePackage{expex}\fi
