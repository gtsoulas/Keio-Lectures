\gtl@new\lx[1]{\textit{#1}}                        % object-language form
\gtl@new\transl[1]{`#1'}                           % translation
\gtl@new\gl[1]{\textsc{\MakeLowercase{#1}}}        % \gl{nom.pl}
\gtl@new\xbar[1]{\ensuremath{\overline{\mbox{#1}}}}% \xbar{T}  T-bar
\gtl@new\trc[1]{\ensuremath{\langle}#1\ensuremath{\rangle}}  % <copy>
\gtl@new\agree{A\textsc{gree}\xspace}
\gtl@new\chl{C\textsubscript{HL}\xspace}

\ifgtl@glosses
  \def\gtl@gloss#1#2{\expandafter\gtl@new\csname#1\endcsname{\gl{#2}\xspace}}
  \gtl@gloss{nom}{nom}   \gtl@gloss{acc}{acc}   \gtl@gloss{gen}{gen}
  \gtl@gloss{dat}{dat}   \gtl@gloss{voc}{voc}
  \gtl@gloss{sg}{sg}     \gtl@gloss{pl}{pl}     \gtl@gloss{du}{du}
  \gtl@gloss{masc}{m}    \gtl@gloss{fem}{f}     \gtl@gloss{neut}{n}
  \gtl@gloss{past}{pst}  \gtl@gloss{pres}{prs}  \gtl@gloss{fut}{fut}
  \gtl@gloss{pfv}{pfv}   \gtl@gloss{ipfv}{ipfv} \gtl@gloss{prf}{prf}
  \gtl@gloss{subj}{sbjv} \gtl@gloss{ind}{ind}   \gtl@gloss{imp}{imp}
  \gtl@gloss{cl}{cl}     \gtl@gloss{comp}{comp} \gtl@gloss{foc}{foc}
  \gtl@gloss{tpc}{top}   \gtl@gloss{NEG}{neg}   \gtl@gloss{DEF}{def}
  \gtl@gloss{indf}{indf} \gtl@gloss{refl}{refl} \gtl@gloss{pass}{pass}
  \gtl@gloss{agr}{agr}   \gtl@gloss{Q}{q}
\fi

