% \exlang{Greek}: language label at the right edge of an example's first line
\gtl@new\exlang[1]{\hfill\raisebox{1.95\baselineskip}[0pt][0pt]{#1}}

% -----------------------------------------------------------------------
% Trees
% -----------------------------------------------------------------------
% minsyn under colblanc: colour scheme follows the theme mode.  Kept in a
% macro: \ifcolblanc@dark is undefined elsewhere and would unbalance
% \if...\fi nesting inside a skipped conditional branch.
\newcommand\gtl@loadminsyn{%
  \@ifundefined{ifcolblanc@dark}{\RequirePackage{minsyn}}{%
    \csname ifcolblanc@dark\endcsname
      \RequirePackage[scheme=accessible]{minsyn}%
    \else
      \RequirePackage[scheme=default]{minsyn}%
      \colorlet{minsyn@wsbg}{gtexbg}%
    \fi
    \colorlet{minsyn@wsfr}{gtaccent}}}
\ifgtl@minsyn
  \gtl@loadminsyn
\else
  \def\gtl@tmp{forest}\ifx\gtl@trees\gtl@tmp
    \RequirePackage[linguistics]{forest}
  \fi
\fi
\ifgtl@beamer
  \@ifpackageloaded{forest}{%
    \forestset{
      default preamble={
        for tree={font=\rmfamily\small, inner sep=2pt, s sep=1.6em,
          l sep=1.8em, edge={gtaccent!50, line width=0.5pt}, draw=none}},
      bracket/.style={for tree={no edge, inner sep=1pt, l=0pt}}}}{}
\fi

% -----------------------------------------------------------------------
% Bibliography
%   \printbib            print the reference list (natbib or biblatex)
%   \citeposs{key}       Chomsky's (1995)
% -----------------------------------------------------------------------
\def\gtl@tmp{natbib}\ifx\gtl@bib\gtl@tmp
  \RequirePackage{natbib}
  \ifx\gtl@bibstyle\@empty \def\gtl@bibstyle{chicago}\fi
  \AtBeginDocument{\bibliographystyle{\gtl@bibstyle}}
  \newcommand\printbib{\bibliography{\gtl@bibfiles}}
\fi
\def\gtl@tmp{biblatex}\ifx\gtl@bib\gtl@tmp
  \ifx\gtl@bibstyle\@empty \def\gtl@bibstyle{authoryear}\fi
  \def\gtl@tmp{unified}%
  \ifx\gtl@bibstyle\gtl@tmp
    \IfFileExists{unified.bbx}{}{%
      \PackageWarningNoLine{gtling}{biblatex-unified not installed;\MessageBreak
        using authoryear (tlmgr install biblatex-unified)}%
      \def\gtl@bibstyle{authoryear}}%
  \fi
  \RequirePackage[backend=biber, style=\gtl@bibstyle, natbib=true,
    maxcitenames=2, maxbibnames=99, uniquelist=false,
    url=false, doi=false, isbn=false, eprint=false]{biblatex}
  \@for\gtl@f:=\gtl@bibfiles\do{\addbibresource{\gtl@f.bib}}
  \newcommand\printbib{\printbibliography}
\fi
\def\gtl@tmp{none}\ifx\gtl@bib\gtl@tmp
  \newcommand\printbib{}
\fi
\gtl@new\citeposs[1]{\citeauthor{#1}'s (\citeyear{#1})}

% -----------------------------------------------------------------------
% Semantics
%   \sem{x}  [[x]]      \sem[M,g]{x}  [[x]]^{M,g}     \dbr{x} = \sem[]{x}
%   \tuple{x} <x> (auto-sized)   \oset{x} <x>   \setof{x} {x} (auto-sized)
%   \set{x} {x}   \card{x} |x|   \type{e,t} <e,t>   P\tsub{e,t}   \lam{x}
% -----------------------------------------------------------------------
\providecommand\gtl@semindex{}
\@ifpackageloaded{unicode-math}
  {\def\gtl@lb{\lBrack}\def\gtl@rb{\rBrack}}
  {\def\gtl@lb{\llbracket}\def\gtl@rb{\rrbracket}}
\newcommand\gtl@sem[2]{%
  \begingroup\protected@edef\gtl@tmp{#1}%
  \ifx\gtl@tmp\@empty
    \ensuremath{\gtl@lb #2\gtl@rb}%
  \else
    \ensuremath{\gtl@lb #2\gtl@rb^{\gtl@tmp}}%
  \fi\endgroup}
\ifdefined\sem
  \PackageInfo{gtling}{\string\sem\space already defined; keeping it}
\else
  \NewDocumentCommand\sem{o m}{%
    \IfNoValueTF{#1}{\gtl@sem{\gtl@semindex}{#2}}{\gtl@sem{#1}{#2}}}
\fi
\gtl@new\dbr[1]{\gtl@sem{}{#1}}
\gtl@new\tuple[1]{\ensuremath{\left\langle #1\right\rangle}}
\gtl@new\oset[1]{\ensuremath{\langle #1\rangle}}
\gtl@new\setof[1]{\ensuremath{\left\{ #1\right\}}}
\gtl@new\set[1]{\ensuremath{\{#1\}}}
\gtl@new\card[1]{\ensuremath{\lvert #1\rvert}}
\gtl@new\type[1]{\ensuremath{\langle #1\rangle}}
\gtl@new\tsub[1]{\ensuremath{_{\langle #1\rangle}}}
\gtl@new\lam[1]{\ensuremath{\lambda #1.\,}}
\gtl@new\ve{\ensuremath{\wedge}}
\gtl@new\Dox{\ensuremath{\mathrm{Dox}}}

% -----------------------------------------------------------------------
% Object language, glosses and syntax
