\gtl@new\jbad{\leavevmode{\color{gtalert}*}}
\gtl@new\jbadd{\leavevmode{\color{gtalert}**}}
\gtl@new\jquest{\leavevmode{\color{gtaccent!60}?}}
\gtl@new\jqquest{\leavevmode{\color{gtaccent!40}??}}
\gtl@new\ok{\jok}
