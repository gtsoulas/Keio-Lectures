%% gtling.sty -- George Tsoulas's linguistics toolkit
%%
%% Shared core for gtarticle, gtbook and beamer talks (colblanc theme):
%% packages for examples, trees, bibliography and tables, plus the
%% personal command set (semantics, glossing, revision markup, ...).
%%
%% Engine: LuaLaTeX.
%%
%% Usage:
%%   gtarticle / gtbook load this automatically (pass options to the class).
%%   Talks:   \documentclass[aspectratio=169]{beamer}
%%            \usetheme{colblanc}            % or \usetheme[dark]{colblanc}
%%            \usepackage[bib=biblatex]{gtling}
%%
%% Options (key=value; defaults first):
%%   examples = linguex | expex | gb4e | none
%%   trees    = forest | none
%%   minsyn   = false | true          minimalist workspace derivations
%%   bib      = natbib | biblatex | none
%%   bibstyle = <style>               default chicago (natbib) / authoryear (biblatex)
%%   bibfile  = fbib                  comma list, no .bib extension
%%   notes    = show | hide           revision markup; `final' = notes=hide
%%   semindex = {}                    default superscript of \sem, e.g. {M,g}
%%   tipa     = false | true
%%   glosses  = true | false          gloss abbreviations \nom, \acc, ...
%%   lang     = british               babel main language (none = no babel)
%%   greek    = true | false          load Greek for babel
%%
%% Full documentation: texdoc gtling-manual (doc/gtling-manual.pdf).
%%
%% Copyright (C) 2026 George Tsoulas. LPPL 1.3c or later.

\NeedsTeXFormat{LaTeX2e}[2023/06/01]
\ProvidesPackage{gtling}[2026/10/15 v1.0 GT linguistics toolkit]

% -----------------------------------------------------------------------
% Options
% -----------------------------------------------------------------------
\newif\ifgtl@notes    \gtl@notestrue
\newif\ifgtl@minsyn   \gtl@minsynfalse
\newif\ifgtl@tipa     \gtl@tipafalse
\newif\ifgtl@glosses  \gtl@glossestrue
\newif\ifgtl@greek    \gtl@greektrue
\newif\ifgtl@beamer
\@ifclassloaded{beamer}{\gtl@beamertrue}{\gtl@beamerfalse}

\ExplSyntaxOn
\keys_define:nn { gtling }
  {
    examples .choices:nn = { linguex, expex, gb4e, none }
      { \tl_gset:Ne \gtl@examples { \l_keys_choice_tl } },
    examples .initial:n  = linguex,
    trees    .choices:nn = { forest, none }
      { \tl_gset:Ne \gtl@trees { \l_keys_choice_tl } },
    trees    .initial:n  = forest,
    minsyn   .code:n     = { \use:c { gtl@minsyn #1 } },
    minsyn   .default:n  = true,
    bib      .choices:nn = { natbib, biblatex, none }
      { \tl_gset:Ne \gtl@bib { \l_keys_choice_tl } },
    bib      .initial:n  = natbib,
    bibstyle .tl_gset:N  = \gtl@bibstyle,
    bibfile  .clist_gset:N = \gtl@bibfiles,
    bibfile  .initial:n  = fbib,
    notes    .choices:nn = { show, hide }
      { \use:c { gtl@notes \int_compare:nNnTF { \l_keys_choice_int } = 1 { true } { false } } },
    final    .code:n     = { \gtl@notesfalse },
    final    .value_forbidden:n = true,
    semindex .tl_gset:N  = \gtl@semindex,
    tipa     .code:n     = { \use:c { gtl@tipa #1 } },
    tipa     .default:n  = true,
    glosses  .code:n     = { \use:c { gtl@glosses #1 } },
    glosses  .default:n  = true,
    lang     .tl_gset:N  = \gtl@lang,
    lang     .initial:n  = british,
    greek    .code:n     = { \use:c { gtl@greek #1 } },
    greek    .default:n  = true,
  }
\ExplSyntaxOff
\ProcessKeyOptions[gtling]

\ifdefined\directlua\else
  \PackageWarningNoLine{gtling}{gtling is designed for LuaLaTeX.\MessageBreak
    Compile with lualatex (latexmk -lualatex)}
\fi

% Define a user command only if the name is free; otherwise keep the
% existing definition and say so in the log.  Keeps gtling usable next
% to packages or old preambles that already claim a name.
\ExplSyntaxOn
\cs_new_protected:Npn \gtl@new #1
  {
    \cs_if_free:NTF #1
      { \newcommand #1 }
      {
        \PackageInfo { gtling } { \token_to_str:N #1 ~ already ~ defined;
          ~ keeping ~ it }
        \gtl@gobbledef
      }
  }
\ExplSyntaxOff
\def\gtl@gobbledef#1#{\@gobble}

