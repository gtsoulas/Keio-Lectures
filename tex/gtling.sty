\gtl@new\ignore[1]{}
\providecommand\gtanon[1]{#1}   % redefined by the classes' anonymous option

% -----------------------------------------------------------------------
% Revision markup -- notes=show (default) | notes=hide (or `final')
%   \correct{..}  margin bar note       \change{..}  bold when shown
%   \note{..}     [bold inline note]    \gtnote[who]{..}  numbered query box
%   \str{..}      strike-through        \todo{..}  todonotes (not in beamer)
% -----------------------------------------------------------------------
\gtl@new\str[1]{{\setbox1=\hbox{#1}\leavevmode
  \raise.45ex\rlap{\leaders\hrule\hskip\wd1}\box1}}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\newcounter{gtnote}
\ifgtl@notes
  \ifgtl@beamer   % no margins on slides: inline
    \gtl@new\correct[1]{\leavevmode{\footnotesize\color{gtalert}[#1]}}
  \else
    \gtl@new\correct[1]{\marginpar{\footnotesize\color{gtaccent}%
      \begin{tabular}[t]{@{}|p{0.85\marginparwidth}@{}}\raggedright#1\end{tabular}}}
  \fi
  \gtl@new\change[1]{\textbf{#1}}
  \ifgtl@beamer\else\gtl@new\note[1]{\textbf{[#1]}}\fi
  \NewDocumentCommand\gtnote{O{} +m}{%
    \refstepcounter{gtnote}%
    \begin{tcolorbox}[breakable, enhanced, colback=gtnotebg,
      colframe=gtnoteframe, coltext=gttext, coltitle=white, boxrule=0.6pt,
      left=5pt, right=5pt, top=3pt, bottom=3pt,
      title={\footnotesize\bfseries Q\thegtnote
        \if\relax\detokenize{#1}\relax\else\ \normalfont\itshape #1\fi}]
    \small #2
    \end{tcolorbox}}
  \ifgtl@beamer\else\RequirePackage{todonotes}\fi
\else
  \gtl@new\correct[1]{}
  \gtl@new\change[1]{#1}
  \ifgtl@beamer\else\gtl@new\note[1]{}\fi
  \NewDocumentCommand\gtnote{O{} +m}{}
  \ifgtl@beamer\else\RequirePackage[disable]{todonotes}\fi
\fi

% -----------------------------------------------------------------------
% Beamer only (from colblanc-preamble)
% -----------------------------------------------------------------------
\ifgtl@beamer
  % \revealfrom{N}{text}: ghosted before overlay N, full from N on
  % \revealon{N}{text}:   full only on overlay N
  \newcommand{\revealfrom}[2]{\temporal<#1>{\ghost{#2}}{#2}{#2}}
  \newcommand{\revealon}[2]{\temporal<#1>{\ghost{#2}}{#2}{\ghost{#2}}}
  % \chain{head}{lower copy}
  \newcommand{\chain}[2]{#1\ldots\colorbox{gtexbg}{\textcolor{gtghost}{#2}}}
  % Unnumbered example block
  \newenvironment{exblock}
    {\begin{beamercolorbox}[sep=0.6em, wd=\linewidth]{block body example}%
     \small\rmfamily}
    {\end{beamercolorbox}}
  % \begin{twocol}{0.45} left \midcol right \end{twocol}
  \newlength{\gtl@leftwd}\newlength{\gtl@rightwd}
  \newenvironment{twocol}[1]{%
    \setlength{\gtl@leftwd}{#1\textwidth}%
    \setlength{\gtl@rightwd}{0.96\textwidth}%
    \addtolength{\gtl@rightwd}{-\gtl@leftwd}%
    \begin{columns}[T]\begin{column}{\gtl@leftwd}}
   {\end{column}\end{columns}}
  \newcommand{\midcol}{\end{column}\begin{column}{\gtl@rightwd}}
\fi

\endinput
